{
  "name": "treksorapp",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit -p tsconfig.mobile.json",
    "test:ui": "node tests/ui-contracts.cjs",
    "test:integrity": "node tests/source-integrity.cjs",
    "test:progress": "node tests/progress-sync.cjs",
    "test:audio": "node tests/audio-lifecycle.cjs",
    "test:dashboard": "node tests/progress-dashboard.cjs",
    "test:content": "node tests/content-sync.cjs",
    "test:journey": "node tests/journey-growth.cjs",
    "release:check": "npm run typecheck && npm run test:integrity && npm run test:progress && npm run test:dashboard && npm run test:journey && npm run test:audio && npm run test:content && npm run test:video && npm run test:clock",
    "release:ios": "npm run release:check && npx --yes eas-cli@26.0.0 build --platform ios --profile production --auto-submit",
    "test:video": "node tests/exercise-video-lifecycle.cjs",
    "test:clock": "node tests/workout-clock.cjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.1.0",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-google-signin/google-signin": "^14.0.1",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/elements": "^2.3.8",
    "@react-navigation/native": "^7.1.6",
    "axios": "^1.11.0",
    "base-64": "^1.0.0",
    "expo": "53.0.19",
    "expo-apple-authentication": "~7.2.4",
    "expo-application": "~6.1.5",
    "expo-av": "~15.1.7",
    "expo-blur": "~14.1.5",
    "expo-constants": "~17.1.6",
    "expo-dev-client": "~5.2.4",
    "expo-font": "~13.3.1",
    "expo-haptics": "~14.1.4",
    "expo-image": "~2.3.2",
    "expo-image-picker": "~16.1.4",
    "expo-linear-gradient": "~14.1.5",
    "expo-linking": "~7.1.7",
    "expo-notifications": "~0.31.4",
    "expo-router": "~5.1.3",
    "expo-secure-store": "^14.2.3",
